<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.axonframework</groupId>
        <artifactId>axon-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../build/parent/pom.xml</relativePath>
    </parent>

    <artifactId>axon-hunt-simulation</artifactId>
    <packaging>jar</packaging>

    <name>Axon Framework - Hunt Simulation</name>
    <description>
        Bug-hunting simulation harness for Axon Framework. Carries the operation-history recorder, the DCB event
        store reference model, and the invariant checkers that every hunt scenario is judged by. Only built under
        the "hunt" profile and never deployed.
    </description>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <!--
          Every test in this module is judged by an oracle over a recorded history. A rerun would hide exactly the
          intermittent break the suite exists to surface, so this module never inherits a rerun count.
        -->
        <surefire.rerunFailingTestsCount>0</surefire.rerunFailingTestsCount>
        <!--
          JUnit tags kept out of the default build. Defaults to "fuzz" so the long seed sweep never runs on a normal
          build; a nightly job clears it with -Dhunt.excludedGroups= . It must be a property rather than a literal in
          the surefire configuration, or the command-line override cannot reach it.
        -->
        <hunt.excludedGroups>fuzz</hunt.excludedGroups>
    </properties>

    <dependencies>
        <!-- JSONL history serialization -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!--
          The harness drives the real framework: a real command bus, a real event store over the fault-injecting
          storage-engine wrapper, and real event processing. Compile scope, because the harness itself is main code
          that both the scenario tests and any future module reuse.
        -->
        <dependency>
            <groupId>org.axonframework</groupId>
            <artifactId>axon-eventsourcing</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>${hunt.excludedGroups}</excludedGroups>
                    <systemPropertyVariables>
                        <hunt.scenario>${hunt.scenario}</hunt.scenario>
                        <hunt.seed>${hunt.seed}</hunt.seed>
                        <hunt.seeds>${hunt.seeds}</hunt.seeds>
                        <hunt.startSeed>${hunt.startSeed}</hunt.startSeed>
                        <hunt.backend>${hunt.backend}</hunt.backend>
                        <hunt.timescale>${hunt.timescale}</hunt.timescale>
                        <hunt.tier>${hunt.tier}</hunt.tier>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.axonframework.examples</groupId>
        <artifactId>axon-framework-examples-spring-cloud</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>university-springcloud-domain</artifactId>

    <name>Axon Framework Examples - Spring Cloud - Domain</name>
    <description>
        Command, event, query, handler, and controller code shared by every Spring Boot variant of the Spring Cloud
        message distribution example. Kept free of any Spring Boot dependency so the exact same classes run
        unmodified under each variant's own Spring Boot version.
    </description>

    <properties>
        <!--
        Pinned to the same version build/parent/pom.xml pins for the framework's own OSS Spring support (see
        <spring.version> there). Only used to give this module's own build a concrete Spring Framework version to
        compile against; every consuming application module supplies its own runtime version through its own
        Spring Boot BOM import, which always wins Maven's version mediation over what is declared here.
        -->
        <spring.version>6.2.19</spring.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework</groupId>
                <artifactId>spring-framework-bom</artifactId>
                <version>${spring.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.axonframework</groupId>
            <artifactId>axon-messaging</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!--
        Compile-time only: every consuming application module supplies the actual runtime Spring Framework
        version through its own Spring Boot starter.
        -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>6.1.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.7</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.axonframework.examples</groupId>
        <artifactId>university-multi-tenancy-examples</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>university-multi-tenancy-core</artifactId>
    <name>Axon Example - Multi-Tenancy - Core</name>
    <description>
        The demo itself: the university model (the per-tenant components, the enrollment command and
        statistics query with their handlers) and the lifecycle that drives it. This is how
        multi-tenancy works, independent of how it is configured. The declarative and Spring Boot
        modules only add the configuration wiring around this core.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.axonframework</groupId>
            <artifactId>axon-messaging</artifactId>
        </dependency>

        <!-- Event sourcing: the per-tenant event-storage slice models a Course as an event-sourced
             entity, sourced and appended to on the write path. -->
        <dependency>
            <groupId>org.axonframework</groupId>
            <artifactId>axon-eventsourcing</artifactId>
        </dependency>

        <!-- Axon Server connector: the shared helper provisions one context per tenant. -->
        <dependency>
            <groupId>io.axoniq.framework</groupId>
            <artifactId>axon-server-connector</artifactId>
        </dependency>

        <!-- The multi-tenancy API the shared components and helpers are typed against. -->
        <dependency>
            <groupId>io.axoniq.framework</groupId>
            <artifactId>axoniq-multi-tenancy</artifactId>
        </dependency>

        <!-- Subscription queries: axon-messaging depends on reactor-core only optionally, so the
             subscription-query gateway method needs it added here explicitly. -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
            <version>${reactor.version}</version>
        </dependency>

        <!-- Used by the Axon Server context helper to await context creation and deletion. -->
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <version>${awaitility.version}</version>
        </dependency>

        <!-- Test Dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
